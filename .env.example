# =====================================================================
# AI Interview Platform — environment variables
# =====================================================================
# Local dev: copy this to .env and fill in at least GEMINI_API_KEY.
# Production: set these in your platform's dashboard (Render / Fly).
# =====================================================================

# --- LLM ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

OPENROUTER_API_KEY=
OPENROUTER_MODELS=google/gemma-4-26b-a4b-it:free,google/gemma-4-31b-it:free,openrouter/free
OPENROUTER_AUTO_DISCOVER=1

LLM_TIMEOUT_S=18
LLM_RETRIES=0
LLM_BACKOFF_S=0.75

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Persistence ---
# Local dev: SQLite file
DATABASE_URL=sqlite:///./data/interview.db
# Production: paste your Supabase or Neon Postgres URL, e.g.
# DATABASE_URL=postgresql://user:pass@db.xxxxx.supabase.co:6543/postgres

# --- Auth ---
AUTH_SECRET_KEY=dev-only-change-me-in-production
AUTH_COOKIE_NAME=ip_session
AUTH_TTL_S=1209600
# Dev defaults (HTTP localhost):
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_SECURE=0
# Production (HTTPS, same origin): SAMESITE=lax, SECURE=1
# Production (HTTPS, cross-site):  SAMESITE=none, SECURE=1

# --- Static frontend ---
# In Docker / production set to 1 (the built UI is at /app/frontend_dist).
SERVE_FRONTEND=0
FRONTEND_DIST_DIR=./frontend_dist

# --- Logging ---
LOG_LEVEL=INFO
LOG_DIR=./logs
